+    assert (nav, fx) == (10.0, 0.0)
+    assert fx_calls == []                        # 不組 "TWD"、不查匯率、不用保底匯率
+    nav, fx = ns["_latest_nav_fx_t7"]({"code": "X", "currency": "TWD",
