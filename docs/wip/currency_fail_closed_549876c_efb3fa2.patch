+def _record_urlopen(monkeypatch, payload):
+    import urllib.request as UR
+    seen = []
+
+    class _R(io.BytesIO):
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *a):
+            return False
+
+    def _open(req, timeout=None):
+        seen.append(getattr(req, "full_url", req))
+        return _R(json.dumps(payload).encode())
+
+    monkeypatch.setattr(UR, "urlopen", _open)
+    return seen
+
