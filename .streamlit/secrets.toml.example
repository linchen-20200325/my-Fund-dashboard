# Copy to .streamlit/secrets.toml and fill in real keys for local dev.
# AppTest tests set these in-test via at.secrets[...]; no .toml needed in CI.

FRED_API_KEY = "your-fred-api-key-here"
GEMINI_API_KEY = "your-gemini-api-key-here"

# ── 保單視圖 (P1.2 + P3) ────────────────────────────────────────────
# 設定步驟見 docs/POLICY_SHEETS_SETUP.md
# Schema：8 必填 + 1 選填（policy_tier, P3）共 9 欄
POLICY_SHEET_ID = "your-google-sheet-id-here"

# ── v19.472：選股池 / NAV 各存「獨立一本」Sheet（與持倉 POLICY_SHEET_ID 不同本）──
# 兩者都已 baked 預設值（見 pool_repository._POOL_SHEET_ID_DEFAULT /
# nav_history_gs._NAV_SHEET_ID_DEFAULT），不設也能跑；要換自己的本才需在此覆蓋。
# ⚠️ 用哪一本，都要把上面的 service account client_email 加為該 Sheet 的「編輯者」。
# POOL_SHEET_ID = "your-pool-google-sheet-id"   # 選股池（含 ISIN 對照）_fund_pool 分頁
# NAV_SHEET_ID  = "your-nav-google-sheet-id"    # 淨值累積 nav_history 分頁

[google_service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
client_email = "your-bot@your-project.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
